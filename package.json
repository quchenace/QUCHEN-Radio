{
  "name": "quchenradio",
  "productName": "QUCHEN Radio",
  "version": "3.1.1",
  "description": "沉浸式音乐播放器，融合天气电台、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "QUCHEN Radio",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "test:quchen-ai": "node --test desktop/quchen-ai-client.test.js"
  },
  "quchenradio": {
    "update": {
      "provider": "github",
      "owner": "quchenace",
      "repo": "QUCHEN-Radio",
      "preview": true,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "electron": "42.4.1",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.quchenradio.desktop",
    "productName": "QUCHEN Radio",
    "electronVersion": "42.4.1",
    "asar": false,
    "files": [
      "**/*",
      "!**/.git/**",
      "!node_modules/.cache/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QUCHEN Radio",
      "artifactName": "QUCHEN-Radio-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "quchenace",
        "repo": "QUCHEN-Radio"
      }
    ]
  }
}